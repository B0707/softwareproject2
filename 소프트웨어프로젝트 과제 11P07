#include <Servo.h>

// 아두이노 핀 설정
#define PIN_LED   9   // LED 핀
#define PIN_TRIG  12  // 초음파 센서 TRIG
#define PIN_ECHO  13  // 초음파 센서 ECHO
#define PIN_SERVO 10  // 서보 모터

// 초음파 센서 매개변수 설정
#define SND_VEL 346.0     // 음속 (24도 기준: 346 m/s)
#define INTERVAL 25       // 샘플링 주기 (ms)
#define PULSE_DURATION 10 // 초음파 펄스 지속 시간 (us)
#define _DIST_MIN 180.0   // 최소 측정 거리 (mm)
#define _DIST_MAX 360.0   // 최대 측정 거리 (mm)

#define TIMEOUT ((INTERVAL / 2) * 1000.0) // 대기 시간 (us)
#define SCALE (0.001 * 0.5 * SND_VEL) // 시간-거리 변환 계수

#define _EMA_ALPHA 0.3    // EMA 필터 가중치 (0 ~ 1)

// 측정으로 얻어낸 서보 펄스 폭 보정값 (us)
#define _DUTY_MIN 500     // 0도 (최소)
#define _DUTY_MAX 2400    // 180도 (최대)
#define _DUTY_NEU ((_DUTY_MIN + _DUTY_MAX) / 2) // 90도 (중립: 1450us)

// 전역 변수
float dist_ema, dist_prev = _DIST_MAX; // 거리 저장 변수 (mm)
unsigned long last_sampling_time;       // 샘플링 시간 관리

Servo myservo;

void setup() {
  // GPIO 핀 초기화
  pinMode(PIN_LED, OUTPUT);
  pinMode(PIN_TRIG, OUTPUT);
  pinMode(PIN_ECHO, INPUT);
  digitalWrite(PIN_TRIG, LOW);
  digitalWrite(PIN_LED, LOW);

  // 서보 모터 연결 및 초기 중립 위치 설정
  myservo.attach(PIN_SERVO);
  myservo.writeMicroseconds(_DUTY_NEU);

  // 초음파 센서 변수 초기화
  dist_prev = _DIST_MIN;
  dist_ema = _DIST_MIN;

  // 시리얼 통신 개시
  Serial.begin(57600);
}

void loop() {
  float dist_raw, dist_filtered;
  int duty_target;

  // 샘플링 주기 대기
  if (millis() < last_sampling_time + INTERVAL)
    return;

  // 초음파 거리 측정
  dist_raw = USS_measure(PIN_TRIG, PIN_ECHO);

  // 1. 범위 필터 (Range Filter): 180mm ~ 360mm 벗어나면 이전값 유지 및 LED OFF
  if ((dist_raw == 0.0) || (dist_raw > _DIST_MAX)) {
    dist_filtered = dist_prev;
    digitalWrite(PIN_LED, LOW);
  } else if (dist_raw < _DIST_MIN) {
    dist_filtered = dist_prev;
    digitalWrite(PIN_LED, LOW);
  } else {
    dist_filtered = dist_raw;
    dist_prev = dist_raw;
    digitalWrite(PIN_LED, HIGH); // 정상 측정 범위 내 들어오면 LED 점등
  }

  // 2. EMA 필터 적용
  dist_ema = _EMA_ALPHA * dist_filtered + (1.0 - _EMA_ALPHA) * dist_ema;

  // 3. 거리에 비례한 연속적 서보 제어 (18cm ~ 36cm -> 0도 ~ 180도)
  if (dist_ema <= _DIST_MIN) {
    duty_target = _DUTY_MIN;
  } else if (dist_ema >= _DIST_MAX) {
    duty_target = _DUTY_MAX;
  } else {
    // 거리에 비례하여 _DUTY_MIN ~ _DUTY_MAX 사이값을 연속 보간
    duty_target = _DUTY_MIN + (dist_ema - _DIST_MIN) * (_DUTY_MAX - _DUTY_MIN) / (_DIST_MAX - _DIST_MIN);
  }

  // 서보 위치 제어
  myservo.writeMicroseconds(duty_target);

  // 4. 시리얼 출력 (과제 요구 서식 준수)
  Serial.print("Min:");   Serial.print(_DIST_MIN);
  Serial.print(",dist:"); Serial.print(dist_raw);
  Serial.print(",ema:");  Serial.print(dist_ema);
  Serial.print(",Servo:"); Serial.print(myservo.read());
  Serial.print(",Max:");  Serial.print(_DIST_MAX);
  Serial.println("");

  // 샘플링 시간 업데이트
  last_sampling_time += INTERVAL;
}

// 초음파 거리 측정 함수 (mm 단위 반환)
float USS_measure(int TRIG, int ECHO) {
  digitalWrite(TRIG, HIGH);
  delayMicroseconds(PULSE_DURATION);
  digitalWrite(TRIG, LOW);

  return pulseIn(ECHO, HIGH, TIMEOUT) * SCALE;
}
